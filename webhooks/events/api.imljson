{
	"output": {
		"{{...}}": "{{omit(body, 'created', 'data')}}",
		"created": "{{parseDate(body.created, 'X')}}",
		"data": {
			"{{...}}": "{{omit(body.data, 'received_at')}}",
			"received_at": "{{if(body.data.received_at, parseDate(body.data.received_at, 'YYYY-MM-DDTHH:mm:ssZ'))}}"
		}
	},
	"respond": {
		"status": 200,
		"type": "json",
		"body": {
			"received": true
		}
	}
}
