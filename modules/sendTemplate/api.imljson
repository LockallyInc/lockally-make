{
	"url": "/v1/send",
	"method": "POST",
	"headers": {
		"Idempotency-Key": "{{uuid}}"
	},
	"body": {
		"from": "{{parameters.from}}",
		"to": "{{parameters.to}}",
		"cc": "{{parameters.cc}}",
		"bcc": "{{parameters.bcc}}",
		"template_id": "{{parameters.templateId}}",
		"variables": "{{templateVariables(parameters)}}",
		"send_at": "{{parameters.send_at}}",
		"unsubscribe": "{{parameters.unsubscribe}}"
	},
	"response": {
		"output": "{{body}}"
	}
}
