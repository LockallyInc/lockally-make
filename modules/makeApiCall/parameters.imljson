[
	{
		"name": "url",
		"type": "text",
		"label": "URL",
		"required": true,
		"help": "Enter the part of the URL that comes after `https://api.lockally.com`. For example, `/v1/templates`. Every endpoint is described at https://developers.lockally.com."
	},
	{
		"name": "method",
		"type": "select",
		"label": "Method",
		"required": true,
		"default": "GET",
		"options": [
			{ "label": "GET", "value": "GET" },
			{ "label": "POST", "value": "POST" },
			{ "label": "PUT", "value": "PUT" },
			{ "label": "PATCH", "value": "PATCH" },
			{ "label": "DELETE", "value": "DELETE" }
		]
	},
	{
		"name": "headers",
		"type": "array",
		"label": "Headers",
		"help": "You don't have to add the Authorization header; the connection adds it. A POST to /v1/send also needs an Idempotency-Key header with a unique value.",
		"spec": {
			"label": "Header",
			"type": "collection",
			"spec": [
				{ "name": "key", "label": "Key", "type": "text" },
				{ "name": "value", "label": "Value", "type": "text" }
			]
		}
	},
	{
		"name": "qs",
		"type": "array",
		"label": "Query String",
		"spec": {
			"label": "Parameter",
			"type": "collection",
			"spec": [
				{ "name": "key", "label": "Key", "type": "text" },
				{ "name": "value", "label": "Value", "type": "text" }
			]
		}
	},
	{
		"name": "body",
		"type": "any",
		"label": "Body",
		"help": "A JSON body, for methods that send one."
	}
]
